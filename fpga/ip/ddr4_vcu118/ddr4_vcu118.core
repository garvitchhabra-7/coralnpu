name: "coralnpuv2:ip:ddr4_vcu118:0.1"
description: "VCU118 DDR4 block design wrapper (MIG + SmartConnect, 256-bit AXI slave)"
virtual:
  - xilinx:virtual:ddr4_0
filesets:
  rtl:
    files:
      - rtl/ddr_system_bd.v
      - rtl/ddr_system_bd_wrapper.v
    file_type: verilogSource

  dcp_files:
    files:
      - dcp/ddr_system_bd_ddr4_0_0.dcp: { file_type: user, copyto: ddr4_vcu118_dcp/ddr_system_bd_ddr4_0_0.dcp }
      - dcp/ddr_system_bd_smartconnect_0_0.dcp: { file_type: user, copyto: ddr4_vcu118_dcp/ddr_system_bd_smartconnect_0_0.dcp }

  xdc_files:
    files:
      - xdc/ddr_system_bd_ddr4_0_0.xdc: { file_type: user, copyto: ddr4_vcu118_xdc/ddr_system_bd_ddr4_0_0.xdc }
      - xdc/ddr4_vcu118_pins.xdc: { file_type: xdc }

  tcl:
    files:
      - vivado_ddr4_vcu118_setup.tcl: { file_type: user, copyto: vivado_ddr4_vcu118_setup.tcl }

targets:
  default:
    filesets:
      - rtl
      - dcp_files
      - xdc_files
      - tcl
